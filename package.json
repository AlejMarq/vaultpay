{
  "name": "vaultpay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "setup": "node scripts/setup.mjs",
    "setup:check": "node scripts/setup-check.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "mock-bank": "node services/mock-core-banking/server.js",
    "test:mock-bank": "node scripts/mock-bank-check.mjs",
    "identity": "node services/identity/server.js",
    "cbi": "node services/cbi/server.js",
    "services": "node scripts/start-services.mjs",
    "test:services": "node scripts/services-check.mjs",
    "fraud": "node services/fraud/server.js",
    "fraud-worker": "node services/orchestrator/fraud-worker.js",
    "test:fraud": "node scripts/fraud-check.mjs",
    "settlement": "node services/settlement/server.js",
    "settlement-worker": "node services/orchestrator/settlement-worker.js",
    "test:settlement": "node scripts/settlement-check.mjs",
    "reconcile": "node services/orchestrator/reconcile.js",
    "test:reconcile": "node scripts/reconcile-check.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:http": "node scripts/http-check.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.10",
    "better-sqlite3": "13.0.3",
    "jose": "6.2.12",
    "next": "16.4.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "selfsigned": "5.5.0"
  }
}
