# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# VaultPay - local databases and application data
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# VaultPay - secrets and private certificates
# (npm run setup writes all of these under data/; these patterns also catch copies elsewhere)
*.key
*.p12
*.pfx
*.crt
*.csr
*.env
*.staging-*
.setup.lock
setup-manifest.json

# VaultPay - local logs and temporary files
logs/
tmp/
temp/

# VaultPay - generated submission archives
*.zip
*.tar.gz

# Windows and VS Code
Thumbs.db
.vscode/*
!.vscode/extensions.json

